MYSQL_DATABASE=market_signal
MYSQL_USER=market_signal
MYSQL_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=3307
FRONTEND_PORT=8080
# Phase 2/3 placeholders; not consumed by Phase 1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEEPSEEK_API_KEY=

# Real OpenAI analysis is opt-in. Never commit your actual API key.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=8192
# Set false to test force analysis without scheduled API calls.
MARKET_WORKER_ENABLED=true
