{
  "Demo": {
    "Enabled": false
  },
  "Storage": {
    "Provider": "Memory"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenAI": {
    "Enabled": false,
    "Model": "gpt-6.1-sol",
    "ReasoningEffort": "medium",
    "MaxOutputTokens": 8192,
    "TimeoutSeconds": 180
  },
  "DeepSeek": {
    "Enabled": false,
    "Model": "deepseek-v4-pro",
    "BaseUrl": "https://api.deepseek.com/",
    "MaxOutputTokens": 8192,
    "TimeoutSeconds": 180
  },
  "NewsIntelligence": { "MaxAgeMinutes": 180 },
  "News": {
    "Model": "deepseek-flash",
    "MaxInputArticles": 90,
    "MaxOutputTokens": 8192,
    "TimeoutSeconds": 180
  }
}
