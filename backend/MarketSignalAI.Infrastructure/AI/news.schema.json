{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "news-intelligence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "title",
          "summary",
          "eventTime",
          "direction",
          "importance",
          "relevance",
          "confidence",
          "timeQuality",
          "eventTimeEvidence",
          "sourceIds"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "MACRO",
              "TECH",
              "TAIWAN"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1800
          },
          "eventTime": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "direction": {
            "type": "string",
            "enum": [
              "POSITIVE",
              "NEGATIVE",
              "NEUTRAL",
              "MIXED",
              "UNKNOWN"
            ]
          },
          "importance": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "relevance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "timeQuality": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "SUPPORTED",
              "RECAP"
            ]
          },
          "eventTimeEvidence": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 90,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}